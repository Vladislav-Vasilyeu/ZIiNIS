# OpenRouter is preserved in the source tree but disabled in the application.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Ollama (локально; logprobs зависят от модели)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=2048

# Tooken Club (https://tooken.club/v1)
TOOKEN_CLUB_API_KEY=
TOOKEN_CLUB_MODEL=gpt-5.5

# По умолчанию
DEFAULT_METHOD=classic_synonyms
DEFAULT_LOGITS_PROVIDER=ollama
